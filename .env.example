# Copy this file to .env and fill in real values.
# Never commit .env — it is gitignored.

# USDA FoodData Central: https://fdc.nal.usda.gov/api-key-signup
EXPO_PUBLIC_USDA_API_KEY=

# Supabase — used to proxy Gemini Vision via an Edge Function.
# The Gemini API key itself lives as a Supabase secret on the server side,
# NOT in this file, so it is never bundled into the client app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
